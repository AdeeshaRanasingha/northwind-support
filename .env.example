# Copy to .env (ignored). Never commit real credentials.
# For an existing database, use its current password; changing this does not rotate it.
MSSQL_SA_PASSWORD=REPLACE_WITH_EXISTING_OR_NEW_STRONG_SQL_PASSWORD

# Generate a unique value of at least 32 characters; this is not a usable secret.
Jwt__SigningKey=REPLACE_WITH_A_UNIQUE_RANDOM_SIGNING_KEY

# Development runs the existing migration/demo initializer. Production does not;
# provision schema, data and credentials separately before starting Production.
ASPNETCORE_ENVIRONMENT=Development

# Optional for local dotnet; Compose uses sqlserver and MSSQL_SA_PASSWORD instead.
ConnectionStrings__Default=Server=localhost,1433;Database=SupportDesk;User Id=sa;Password=REPLACE_WITH_SQL_PASSWORD;TrustServerCertificate=True;Encrypt=False
